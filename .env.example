# Copy to .env.local and fill in real values: `cp .env.example .env.local`
#
# The four uncommented keys below are REQUIRED. lib/env.ts validates them with
# zod at import time and crashes startup if any is missing or malformed, so a
# half-filled file fails loudly rather than at first use.

# --- Required -----------------------------------------------------------------

# MongoDB connection string.
DATABASE_URL=mongodb://localhost:27017/freeclouds

# Must be at least 32 characters (zod enforces the minimum).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars

# From @BotFather. The bot must be an admin of the target channel.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOPqrsTUVwxyz

# The channel that stores file bytes. Use the -100... form for channels.
# Find it via https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890

# --- Optional (defaults shown) ------------------------------------------------

# NODE_ENV=development
# BASE_URL=http://localhost:3000
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_TIMEOUT_MS=30000
# TELEGRAM_MAX_RETRIES=3

# Origin allowed to make cookie-authenticated writes (CSRF check).
# ALLOWED_ORIGIN=http://localhost:3000

# --- Read directly via process.env, not validated by lib/env.ts ---------------

# Outbound email (verification codes, share notifications). Without these,
# sending mail fails and the affected endpoints return 500.
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=your_gmail_app_password

# Absolute site URL used for SEO metadata, OG images and sitemap.xml.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Search-engine verification codes, emitted as meta tags only when set.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# Optional fallback cookie jar for the ytdl-core YouTube path.
# YOUTUBE_COOKIES=
# Cap for YouTube downloads in bytes (default 1GB).
# YOUTUBE_MAX_BYTES=1073741824

# Only needed if you enable the Vercel Blob download cache.
# BLOB_READ_WRITE_TOKEN=
